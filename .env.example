# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose this to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp click-to-chat number, digits only, country code first (no +, no spaces)
WHATSAPP_NUMBER=97455556677
NEXT_PUBLIC_WHATSAPP_NUMBER=97455556677
